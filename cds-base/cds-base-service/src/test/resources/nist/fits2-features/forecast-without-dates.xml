    <Group>Forward Compatibility</Group>
    <DateType>RELATIVE</DateType>
    <MetaData>
        <version>1</version>
        <dateCreated>2018-09-20Z</dateCreated>
        <dateLastUpdated>2019-02-12Z</dateLastUpdated>
    </MetaData>
    <AssessmentDate>
        <Relative>
            <Rule years="0" months="0" days="0" weeks="0">
                <RelativeTo position="BEFORE" reference="EVALDATE"/>
            </Rule>
        </Relative>
    </AssessmentDate>
    <Patient>
        <Gender>Female</Gender>
