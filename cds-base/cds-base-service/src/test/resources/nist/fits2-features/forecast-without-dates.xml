                <Evaluation status="Valid">
                    <Vaccine name="Hep B, unspecified formulation" cvx="45"/>
                </Evaluation>
            </Evaluations>
        </Event>
    </Events>
    <Forecasts>
        <Forecast>
            <target name="Hep B, unspecified formulation" cvx="45"/>
            <SerieStatus code="X" details="Aged Out"/>
            <ForecastReason>Patient has aged out of the series</ForecastReason>
            <DoseNumber>1</DoseNumber>
        </Forecast>
    </Forecasts>
